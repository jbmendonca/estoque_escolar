# ---- Banco de dados (PostgreSQL) ----
# Nunca comite segredos reais. Estes são valores de exemplo para desenvolvimento local.
DATABASE_URL="postgresql://estoque:estoque@localhost:5432/estoque_escolar?schema=public"

# ---- Sessão ----
# Gere um valor aleatório forte em produção (ex.: openssl rand -base64 32)
SESSION_SECRET="troque-por-um-segredo-aleatorio-de-32+caracteres"

# ---- Ambiente ----
NODE_ENV="development"

# ---- Regras de negócio ----
# Dias padrão para considerar um lote "próximo do vencimento"
NEAR_EXPIRY_DAYS_DEFAULT="30"
