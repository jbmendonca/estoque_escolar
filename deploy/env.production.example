# Modelo do .env.production usado pelo deploy na VPS.
# Copie para a raiz do projeto como .env.production e preencha os segredos.
#   cp deploy/env.production.example .env.production && chmod 600 .env.production

# ---- Domínios ----
APP_HOST="estoque.tkrtecnologia.cloud"
API_HOST="apiestoque.tkrtecnologia.cloud"

# ---- Traefik ----
# Deixe em branco para o deploy.sh detectar automaticamente a partir do
# container do Traefik em execução. Preencha só se a detecção falhar.
TRAEFIK_NETWORK=""
TRAEFIK_CERTRESOLVER=""

# ---- Banco de dados ----
# Gere com: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
POSTGRES_PASSWORD=""

# ---- Sessão ----
# Gere com: openssl rand -base64 32
SESSION_SECRET=""

# ---- Administrador inicial ----
ADMIN_EMAIL="joao.mendoncarr@gmail.com"
ADMIN_PASSWORD=""
ADMIN_NAME="João Mendonça"

# ---- Tenant inicial ----
SCHOOL_NAME="Escola Municipal"
SCHOOL_CODE="ESC-001"
