# Normaliza fim de linha: LF no repositório, conversão automática no checkout
* text=auto eol=lf

# Arquivos que devem manter CRLF no Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários — nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles: gerados, ocultar no diff do GitHub
package-lock.json linguist-generated=true -diff
